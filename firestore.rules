rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // LifeGuard Production Healthcare Security & Authorization Model
    // Enforces RBAC & Least-Privilege Access across 6 distinct roles:
    // 1. Patient: Primary user managing medical records, QR ID & medications
    // 2. Donor: Voluntary blood donor managing availability & search
    // 3. Caregiver: Authorized family/clinical caregiver with delegated access
    // 4. Hospital Staff: Verified clinical staff managing blood bank & triage
    // 5. Administrator: System auditor, compliance & hospital verification
    // 6. Responder: Certified paramedic / 108 first responder for triage
    // ===============================================================

    // ---------------------------------------------------------
    // HELPER FUNCTIONS & RBAC ENFORCEMENT
    // ---------------------------------------------------------
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'administrator'];
    }
    
    function isHospitalStaff() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['hospital_staff', 'hospital'];
    }

    function isResponder() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['responder', 'paramedic'];
    }
    
    function isVerifiedHospital(hospitalId) {
      return exists(/databases/$(database)/documents/hospitals/$(hospitalId)) &&
        get(/databases/$(database)/documents/hospitals/$(hospitalId)).data.status == 'verified';
    }

    // Helper to verify if caller is an active or registered caregiver for the patient
    function isCaregiver(userId) {
      return isAuthenticated() && (
        (
          exists(/databases/$(database)/documents/users/$(userId)/caregivers/$(request.auth.uid)) && 
          (
            !('status' in get(/databases/$(database)/documents/users/$(userId)/caregivers/$(request.auth.uid)).data) || 
            get(/databases/$(database)/documents/users/$(userId)/caregivers/$(request.auth.uid)).data.status in ['active', 'registered']
          )
        ) ||
        (
          exists(/databases/$(database)/documents/users/$(userId)/caregiverPermissions/$(request.auth.uid)) && 
          (
            !('status' in get(/databases/$(database)/documents/users/$(userId)/caregiverPermissions/$(request.auth.uid)).data) || 
            get(/databases/$(database)/documents/users/$(userId)/caregiverPermissions/$(request.auth.uid)).data.status in ['active', 'registered']
          )
        )
      );
    }

    // ---------------------------------------------------------
    // USERS & ROLE MANAGEMENT
    // ---------------------------------------------------------
    
    match /users/{userId} {
      // Any authenticated user can read basic user profile info (name, role, public stats)
      allow read: if isAuthenticated();
      
      // User can create their own account (role must not be escalated to admin/hospital/responder)
      allow create: if (
        isOwner(userId) && (
          !('role' in request.resource.data) || 
          request.resource.data.role in ['patient', 'user', 'donor', 'caregiver']
        )
      ) || isAdmin();

      // Only the user themselves can update their profile, or administrators
      // Privilege escalation guard: standard users cannot elevate their role to admin, hospital_staff, or responder
      allow update: if isAdmin() || (
        isOwner(userId) && (
          !('role' in request.resource.data) || 
          request.resource.data.role == resource.data.role ||
          (
            request.resource.data.role in ['patient', 'user', 'donor', 'caregiver'] && 
            (!('role' in resource.data) || resource.data.role in ['patient', 'user', 'donor', 'caregiver'])
          )
        )
      );

      // Account deletion by owner or admin
      allow delete: if isOwner(userId) || isAdmin();
    }
    
    // ---------------------------------------------------------
    // STRICT MEDICAL DATA ISOLATION (OWNER ONLY)
    // ---------------------------------------------------------
    
    match /users/{userId}/medicalProfile/{docId} {
      allow read, write: if isOwner(userId);
    }
    
    match /users/{userId}/medications/{medId} {
      allow read, write: if isOwner(userId);
    }
    
    match /users/{userId}/emergencyContacts/{contactId} {
      allow read, write: if isOwner(userId);
    }
    
    match /users/{userId}/medicalDocuments/{docId} {
      allow read, write: if isOwner(userId);
    }

    // ---------------------------------------------------------
    // USER SESSIONS, CONSENTS & SECURITY EVENTS (Req 6)
    // ---------------------------------------------------------

    match /users/{userId}/sessions/{sessionId} {
      // Read & write strictly isOwner(userId)
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/securityEvents/{eventId} {
      // Read isOwner(userId) || isAdmin()
      allow read: if isOwner(userId) || isAdmin();
      
      // Append-only: authenticated client or system logging auth/security alerts
      allow create: if isAuthenticated();
      
      // Strictly immutable
      allow update, delete: if false;
    }

    match /users/{userId}/consents/{consentId} {
      // Read & write strictly isOwner(userId)
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/securitySettings/{docId} {
      // Read & write strictly isOwner(userId)
      allow read, write: if isOwner(userId);
    }

    // ---------------------------------------------------------
    // DIGITAL HEALTH RECORDS & CAREGIVERS (Req 3)
    // ---------------------------------------------------------

    match /users/{userId}/healthRecords/{docId} {
      // Allow read if owner or authorized caregiver
      allow read: if isOwner(userId) || isCaregiver(userId) || (
        isAuthenticated() && 
        resource != null && 
        'caregivers' in resource.data && 
        resource.data.caregivers is list && 
        request.auth.uid in resource.data.caregivers
      );

      // Allow write if owner or authorized caregiver
      allow write: if isOwner(userId) || isCaregiver(userId);
    }

    // ---------------------------------------------------------
    // MEDICINE MANAGEMENT & HOSPITAL APPOINTMENTS (Req 3)
    // ---------------------------------------------------------

    match /users/{userId}/medicineManagement/{docId} {
      // Allow read & write if owner or authorized caregiver
      allow read, write: if isOwner(userId) || isCaregiver(userId);
    }

    match /users/{userId}/appointments/{appointmentId} {
      // Allow read if owner, hospital staff, admin, or caregiver
      allow read: if isOwner(userId) || isHospitalStaff() || isAdmin() || isCaregiver(userId);

      // Allow write if owner, hospital staff, admin, or caregiver
      allow write: if isOwner(userId) || isHospitalStaff() || isAdmin() || isCaregiver(userId);
    }

    // ---------------------------------------------------------
    // FAMILY CIRCLE STATE & SUBCOLLECTIONS
    // ---------------------------------------------------------

    match /users/{userId}/familyCircle/{docId} {
      // Allow read if owner, or authenticated family member / caregiver with active permissions
      allow read: if isOwner(userId) || (
        isAuthenticated() && (
          isCaregiver(userId) ||
          (resource != null && (
            ('members' in resource.data && resource.data.members is list && request.auth.uid in resource.data.members) ||
            ('memberUserIds' in resource.data && resource.data.memberUserIds is list && request.auth.uid in resource.data.memberUserIds) ||
            ('caregivers' in resource.data && resource.data.caregivers is list && request.auth.uid in resource.data.caregivers) ||
            ('authorizedUsers' in resource.data && resource.data.authorizedUsers is list && request.auth.uid in resource.data.authorizedUsers)
          ))
        )
      );

      // Only patient/owner can manage their family circle state
      allow write: if isOwner(userId);

      // Support any nested subcollections under familyCircle
      match /{subcollection}/{subDocId} {
        allow read: if isOwner(userId) || isCaregiver(userId);
        allow write: if isOwner(userId);
      }
    }

    // ---------------------------------------------------------
    // CAREGIVER PERMISSIONS & DELEGATED ACCESS
    // ---------------------------------------------------------

    match /users/{userId}/caregivers/{caregiverId} {
      // Allow read if owner or the caregiver themselves
      allow read: if isOwner(userId) || (
        isAuthenticated() && (
          request.auth.uid == caregiverId ||
          (resource != null && 'caregiverUserId' in resource.data && resource.data.caregiverUserId == request.auth.uid)
        )
      );
      // Only the patient/owner can manage their caregivers
      allow write: if isOwner(userId);
    }

    match /users/{userId}/caregiverPermissions/{permId} {
      // Allow read if owner or the caregiver themselves
      allow read: if isOwner(userId) || (
        isAuthenticated() && (
          request.auth.uid == permId || 
          (resource != null && 'caregiverUserId' in resource.data && resource.data.caregiverUserId == request.auth.uid)
        )
      );
      // Only patient/owner can grant or revoke permissions
      allow write: if isOwner(userId);
    }

    // ---------------------------------------------------------
    // CHILD SAFETY EMERGENCY PROFILES
    // ---------------------------------------------------------

    match /users/{userId}/childProfiles/{childId} {
      // Legal guardian (owner) or authorized family circle members can read
      allow read: if isOwner(userId) || (
        isAuthenticated() && (
          isCaregiver(userId) ||
          (resource != null && (
            ('authorizedMembers' in resource.data && resource.data.authorizedMembers is list && request.auth.uid in resource.data.authorizedMembers) ||
            ('members' in resource.data && resource.data.members is list && request.auth.uid in resource.data.members) ||
            ('caregivers' in resource.data && resource.data.caregivers is list && request.auth.uid in resource.data.caregivers)
          ))
        )
      );

      // Legal guardian can create with explicit consent verification
      allow create: if isOwner(userId)
        && request.resource.data.guardianConsentConfirmed == true
        && (!('guardianUserId' in request.resource.data) || request.resource.data.guardianUserId == userId);

      // Legal guardian can update with explicit consent verification and immutable childId
      allow update: if isOwner(userId)
        && request.resource.data.guardianConsentConfirmed == true
        && (!('guardianUserId' in request.resource.data) || request.resource.data.guardianUserId == userId)
        && (!('childId' in resource.data) || !('childId' in request.resource.data) || request.resource.data.childId == resource.data.childId);

      // Legal guardian can delete
      allow delete: if isOwner(userId);
    }

    // ---------------------------------------------------------
    // CAREGIVER & USER ACCESS AUDIT LOGS (Req 5)
    // ---------------------------------------------------------

    match /users/{userId}/accessLogs/{logId} {
      // Owner (patient) or admin can view caregiver access audit trail
      allow read: if isOwner(userId) || isAdmin();
      
      // Append-only: authenticated caregiver, responder, or patient when accessing records
      allow create: if isAuthenticated();
      
      // Audit logs are strictly immutable
      allow update, delete: if false;
    }

    // ---------------------------------------------------------
    // ROOT FAMILY CIRCLES & INVITATIONS
    // ---------------------------------------------------------

    match /familyCircles/{circleId} {
      // Circle read if user is member or admin
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (resource != null && (
          resource.data.adminUserId == request.auth.uid ||
          ('memberUserIds' in resource.data && resource.data.memberUserIds is list && request.auth.uid in resource.data.memberUserIds) ||
          ('members' in resource.data && resource.data.members is list && request.auth.uid in resource.data.members)
        ))
      );

      // Circle create if authenticated
      allow create: if isAuthenticated() 
        && (!('adminUserId' in request.resource.data) || request.resource.data.adminUserId == request.auth.uid);

      // Circle update if admin of the circle or system admin
      allow update: if isAuthenticated() && (
        isAdmin() ||
        resource.data.adminUserId == request.auth.uid
      );

      // Circle delete if admin of the circle or system admin
      allow delete: if isAuthenticated() && (
        isAdmin() ||
        resource.data.adminUserId == request.auth.uid
      );

      // Allow access to circle subcollections (e.g. alerts, logs, updates)
      match /{subcollection}/{docId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && (
          get(/databases/$(database)/documents/familyCircles/$(circleId)).data.adminUserId == request.auth.uid ||
          isAdmin()
        );
      }
    }
    
    match /familyInvitations/{inviteId} {
      // Read if sender or recipient phone/email/uid matches auth, or admin
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (resource != null && (
          resource.data.senderId == request.auth.uid ||
          ('recipientUserId' in resource.data && resource.data.recipientUserId == request.auth.uid) ||
          ('recipientEmail' in resource.data && request.auth.token.email != null && resource.data.recipientEmail == request.auth.token.email) ||
          ('recipientPhone' in resource.data && request.auth.token.phone_number != null && resource.data.recipientPhone == request.auth.token.phone_number)
        ))
      );

      // Create if sender or admin
      allow create: if isAuthenticated() && (
        isAdmin() ||
        request.resource.data.senderId == request.auth.uid
      );

      // Update if recipient accepting/rejecting, or sender/admin
      allow update: if isAuthenticated() && (
        isAdmin() ||
        resource.data.senderId == request.auth.uid ||
        (
          (
            ('recipientUserId' in resource.data && resource.data.recipientUserId == request.auth.uid) ||
            ('recipientEmail' in resource.data && request.auth.token.email != null && resource.data.recipientEmail == request.auth.token.email) ||
            ('recipientPhone' in resource.data && request.auth.token.phone_number != null && resource.data.recipientPhone == request.auth.token.phone_number) ||
            (request.resource.data.recipientUserId == request.auth.uid)
          ) &&
          request.resource.data.status in ['accepted', 'rejected', 'pending'] &&
          request.resource.data.senderId == resource.data.senderId &&
          request.resource.data.circleId == resource.data.circleId
        )
      );

      // Delete if sender or admin
      allow delete: if isAuthenticated() && (
        isAdmin() ||
        resource.data.senderId == request.auth.uid
      );
    }

    // ---------------------------------------------------------
    // DONORS
    // ---------------------------------------------------------
    
    match /donors/{userId} {
      // Any verified hospital staff, admin, or donor themselves can read donor profile
      allow read: if isOwner(userId) || isHospitalStaff() || isAdmin();
      allow write: if isOwner(userId);
    }

    // ---------------------------------------------------------
    // HOSPITALS
    // ---------------------------------------------------------
    
    match /hospitals/{hospitalId} {
      // Public can read verified hospitals; staff and admin can read all
      allow read: if (resource == null) || resource.data.status == 'verified' || isAdmin() || isHospitalStaff();
      // Anyone authenticated can register a hospital, admins verify it
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || (isHospitalStaff() && resource.data.createdBy == request.auth.uid);
    }

    // ---------------------------------------------------------
    // BLOOD REQUESTS & RESPONSES
    // ---------------------------------------------------------
    
    match /bloodRequests/{requestId} {
      // Anyone authenticated can view blood requests
      allow read: if isAuthenticated();
      // Only verified hospital staff can create requests
      allow create: if isHospitalStaff() && isVerifiedHospital(request.resource.data.hospitalId);
      allow update: if (isHospitalStaff() && resource.data.createdBy == request.auth.uid) || isAdmin();
      allow delete: if isAdmin();
      
      match /donorResponses/{responseId} {
        // Authenticated users can view responses and hospital staff can view all
        allow read: if isAuthenticated();
        // Any user can respond with their own donor ID
        allow create: if isAuthenticated() && request.resource.data.donorId == request.auth.uid;
        allow update: if isAuthenticated() && (resource.data.donorId == request.auth.uid || isHospitalStaff());
      }
    }

    match /blood_requests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isHospitalStaff() || isAdmin();
      allow update: if isHospitalStaff() || isAdmin();
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------
    // PATIENT CLINICAL HANDOVERS (PARAMEDIC / RESPONDER & ER)
    // ---------------------------------------------------------

    match /patient_handovers/{handoverId} {
      allow read: if isHospitalStaff() || isResponder() || isAdmin();
      allow create: if isHospitalStaff() || isResponder() || isAdmin();
      allow update: if isHospitalStaff() || isResponder() || isAdmin();
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------
    // EMERGENCY TOKENS & PUBLIC LOOKUP (Req 5)
    // ---------------------------------------------------------
    
    match /emergencyTokens/{tokenId} {
      // Read allowed for active tokens (public emergency lookup) or by owner/admin
      allow get: if (resource == null) || 
        (resource.data.active == true) || 
        (isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin()));
      
      allow list: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        isAdmin()
      );
      
      // Write strictly owner only
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId) && 
        (!('userId' in request.resource.data) || request.resource.data.userId == resource.data.userId);
      allow delete: if isOwner(resource.data.userId);
    }
    
    // ---------------------------------------------------------
    // EMERGENCY ACCESS LOGS (Req 5)
    // ---------------------------------------------------------

    match /emergencyAccessLogs/{logId} {
      // Owner of the referenced patient record or admin can review access logs
      allow read: if isAuthenticated() && (
        isAdmin() || 
        (resource != null && 'userId' in resource.data && resource.data.userId == request.auth.uid)
      );
      
      // Append-only: anyone scanning the QR can generate an access log
      allow create: if true;
      
      // Audit logs are strictly immutable
      allow update, delete: if false;
    }

    // ---------------------------------------------------------
    // NOTIFICATIONS & SYSTEM CONFIG
    // ---------------------------------------------------------
    
    match /fcmTokens/{tokenId} {
      allow read, write: if isOwner(request.resource.data.userId);
    }
    
    match /adminConfig/{docId} {
      allow read, write: if isAdmin();
    }

    // ---------------------------------------------------------
    // EMERGENCY EVENTS & CASES (Req 4)
    // ---------------------------------------------------------
    
    match /emergencyEvents/{eventId} {
      // Owner, admin, or isResponder() can read emergency events
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        isAdmin() || 
        isResponder()
      );
      
      // Owner can create an emergency event
      allow create: if isAuthenticated() 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.id is string
        && request.resource.data.status in ['Created', 'Alert Sent', 'Acknowledged', 'Assistance Accepted', 'Resolved']
        && (!('category' in request.resource.data) || request.resource.data.category in ['Vehicle Accident', 'Severe Fall', 'Cardiac Emergency', 'Medical Crisis', 'Physical Threat', 'General SOS'])
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string;
      
      // Owner, admin, or isResponder() can update status (e.g. 'Acknowledged', 'Assistance Accepted', 'Resolved')
      allow update: if isAuthenticated() 
        && (resource.data.userId == request.auth.uid || isAdmin() || isResponder())
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && (!('status' in request.resource.data) || request.resource.data.status in ['Created', 'Alert Sent', 'Acknowledged', 'Assistance Accepted', 'Resolved']);
      
      // Only admins can delete emergency events
      allow delete: if isAdmin();

      // Telemetry or incident logs under an emergency event
      match /{subcollection}/{docId} {
        allow read, write: if isAuthenticated() && (
          get(/databases/$(database)/documents/emergencyEvents/$(eventId)).data.userId == request.auth.uid ||
          isAdmin() ||
          isResponder()
        );
      }
    }
  }
}
