<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 1. Notification Permissions (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 2. Exact Alarms for Doze-Proof Medicine Reminders -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- 3. Boot Restoration for Medication Alarms -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 4. Permitted Background Sensor Monitoring -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 5. Emergency GPS Coordinates (Requested Just-in-Time for SOS) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- 6. Network for Secure Sync with LifeGuard Cloud -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".LifeGuardApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/backup_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LifeGuardCompanion"
        tools:targetApi="35">

        <!-- Main Application Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.LifeGuardCompanion">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep Linking from LifeGuard Web / PWA -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="lifeguard-azure.vercel.app"
                    android:pathPrefix="/companion" />
            </intent-filter>

            <!-- Custom URI Scheme for PWA App Handoff -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="lifeguard"
                    android:host="companion" />
            </intent-filter>
        </activity>

        <!-- Lock-Screen Medical ID Activity (Accessible over Keyguard without unlocking) -->
        <activity
            android:name=".ui.LockScreenActivity"
            android:exported="false"
            android:label="@string/lock_screen_medical_id_title"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.LifeGuardCompanion.LockScreen" />

        <!-- Permitted Background Sensor Monitoring Foreground Service -->
        <service
            android:name=".sensor.SensorMonitoringService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Severe vehicular collision and hard fall shockwave detection with user-confirmed emergency distress prompt" />
        </service>

        <!-- Doze-Proof Local Alarm Receiver for Medication Schedule -->
        <receiver
            android:name=".receiver.AlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- Reboot Listener for Restoring Alarms & Persistent Lock-Screen Notification -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 1-Tap Dose Action Receiver (Mark Taken / Snooze directly from Notification) -->
        <receiver
            android:name=".receiver.DoseActionReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- Lock-Screen Emergency Action Receiver -->
        <receiver
            android:name=".receiver.EmergencyActionReceiver"
            android:enabled="true"
            android:exported="false" />

    </application>

</manifest>
